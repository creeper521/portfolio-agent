# Copy outside the repository for real-model local development.
# Never commit real API keys. The normal model-disabled local path does not
# require this file; PostgreSQL runtime settings live in .env.postgres.local.
#
# Spring Boot reads process environment variables. Load this file through your
# IDE, deployment platform, or shell before starting the application.

# Enable the configured catalog only after reviewing each enabled model.
PORTFOLIO_MODEL_RUNTIME_ENABLED=true

# Each enabled model has an independent credential and data-policy gate.
PORTFOLIO_GLM_ENABLED=true
PORTFOLIO_GLM_API_KEY=
PORTFOLIO_GLM_DATA_POLICY_APPROVED=false
PORTFOLIO_QWEN_ENABLED=false
PORTFOLIO_QWEN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
PORTFOLIO_QWEN_API_KEY=
PORTFOLIO_QWEN_DATA_POLICY_APPROVED=false

# Optional runtime tuning.
PORTFOLIO_MODEL_MAX_OUTPUT_TOKENS=1200
PORTFOLIO_GOAL_INTERPRETATION_MAX_OUTPUT_TOKENS=1600
PORTFOLIO_CONVERSATION_MAX_INPUT_TOKENS=12000
