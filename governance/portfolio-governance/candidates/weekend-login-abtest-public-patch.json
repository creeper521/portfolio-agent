  "cases": [
    {
      "id": "case-abtest-experiment-design",
      "code": "CASE-53",
      "slug": "abtest-experiment-design",
      "type": "FEATURE",
      "title": "实验设计与稳定分流",
      "summary": "将业务需求转化为先分层、再分桶并持久化标签的稳定实验模型。",
      "problem": "直接随机分组可能造成两组历史活跃度分布不均，临时计算分组还可能使同一实验对象在不同请求或实例间发生组别漂移。",
      "actions": [
        "明确实验假设、A/B 唯一变量和实验单位。",
        "使用实验前历史登录天数划分连续且不重叠的活跃度层。",
        "在每层内部执行等比例稳定分桶。",
        "持久化实验标签，保证跨请求与跨实例归组一致。",
        "区分分配、激活、曝光和转化阶段。"
      ],
      "decisions": [
        "基线窗口在实验开始前冻结，活动期间的行为不反向改变分层。",
        "分层用于控制历史活跃度差异，分桶用于在层内分配实验方案。",
        "稳定标签属于实验身份的一部分，不能只保存在单实例缓存中。"
      ],
      "verification": [
        "检查分层区间连续、无交叉并覆盖边界值。",
        "检查每层内两组规则只存在唯一实验变量差异。",
        "检查同一对象重复判定和跨实例判定结果一致。"
      ],
      "outcome": "形成先分层、再分桶、标签持久化的实验模型，为配置执行、事件核对和结果分析提供一致口径。",
      "limitations": [
        "公开材料不展示实验标识、分层键、对象标识或实际样本数据。",
        "不公开或推断实验带来的具体业务指标变化。"
      ],
      "achievementStatus": "DELIVERED",
      "contributionType": "PRIMARY",
      "projectId": "weekend-login-abtest-project",
      "claimIds": [
        "claim-abtest-experiment-design"
      ],
