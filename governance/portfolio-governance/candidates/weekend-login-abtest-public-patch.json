    {
      "id": "case-abtest-validation-risk-control",
      "code": "CASE-55",
      "slug": "abtest-validation-risk-control",
      "type": "FEATURE",
      "title": "验证、观测与风险控制",
      "summary": "从配置可执行扩展到分层、稳定性、事件口径和回滚边界的一致性验证。",
      "problem": "代码和 SQL 可执行不代表实验可信；分层缺口、组别漂移、配置未刷新、曝光事件缺失和不完整回滚都会污染实验结果。",
      "actions": [
        "设计分层边界、区间覆盖、层内比例、重复调用、持久化、地区隔离和版本刷新测试。",
        "核对活动实例、规则数量、实验身份、缓存加载和服务实例收敛。",
        "区分服务端分配事件与客户端真实曝光，并建立分配、激活、曝光、领取和结果指标的分析口径。",
        "设计正常结束、紧急停止和回滚流程。",
        "将已分配对象、已曝光对象、奖励状态和异常数据纳入处置范围。"
      ],
      "decisions": [
        "页面展示成功不作为实验闭环的唯一验收标准。",
        "实验异常是否需要停止同时考虑玩家影响和实验可信度。",
        "回滚先明确只阻止新对象进入，还是同时处理已经入组的对象。"
      ],
      "verification": [
        "执行 SQL 前后分别核对活动实例、规则数量和配置版本。",
        "核对分配时间、激活时间、曝光时间和转化时间的先后关系。",
        "按新对象、已分配未曝光、已曝光未领取和已领取四类状态检查处置边界。"
      ],
      "outcome": "把实验验收从页面可展示和 SQL 可执行扩展为配置、服务端、缓存、埋点、分析及回滚边界的一致性验证。",
      "limitations": [
        "公开内容支持测试设计、事件口径核对和回滚预案，不声明发生过线上事故或执行过线上回滚。",
        "缺少可公开实验结果数字，因此不评价奖励方案的业务胜负。"
      ],
