  "projects": [
    {
      "id": "weekend-login-abtest-project",
      "code": "P-07",
      "slug": "weekend-login-abtest",
      "title": "周末登录奖励 ABTest 完整闭环",
      "summary": "深度参与重要运营活动从实验需求拆解到发布验证的完整闭环，围绕历史活跃度分层与层内稳定分桶，完成服务端实验能力扩展、配置 SQL、测试验证、埋点核对及回滚方案设计。",
      "background": "重要运营活动需要验证单一奖励变量对后续活跃的影响。实现不仅要让两组方案正确生效，还要保证样本可比、归组稳定、事件口径一致，并具备异常停止与回滚边界。",
      "responsibilities": [
        "将业务需求转化为可执行实验模型，明确实验假设、A/B 唯一变量、实验单位和三个时间窗口。",
        "设计历史登录天数分层与层内等比例分桶方案，并通过持久化标签保持归组稳定。",
        "扩展服务端实验条件能力，打通配置、缓存、条件判断与活动激活链路。",
        "编写和迭代多地区活动 SQL，处理活动实例、实验身份、分层区间和配置版本。",
        "设计测试矩阵，核对埋点和分析口径，并准备停止实验与回滚预案。"
      ],
      "solution": "在实验开始前冻结历史登录基线，先按登录天数划分连续且不重叠的活跃度层，再在每层内部进行稳定分桶；实验标签写入持久化存储，服务端按统一配置链路完成规则加载、标签生成和活动激活，并以分配、激活、曝光和转化的分阶段事件支持验证。",
      "keyDecisions": [
        "先按历史登录天数分层，再在每层内部稳定分桶，降低历史活跃度差异的干扰。",
        "每期实验使用独立实验身份，避免旧标签污染新样本。",
        "将已经分配和真实曝光分开统计。",
        "在实验开始前冻结基线窗口，避免活动行为反向改变分层。",
        "回滚覆盖配置、缓存、活动状态、持久化标签和实验数据，不以 SQL 执行成功作为完成标准。"
      ],
      "technologies": [
        "Java",
        "Spring Boot",
        "MySQL",
        "缓存",
        "配置管理",
        "A/B Testing",
        "数据埋点"
      ],
      "verification": [
        "验证分层区间连续、无重叠并覆盖历史登录天数边界。",
        "验证同一实验对象重复进入、跨请求和跨实例时保持同一组别。",
        "核对活动实例、实验身份、配置版本、地区策略和缓存加载结果。",
        "区分并核对分配、激活、曝光、领取和结果事件。",
        "按正常结束、紧急停止和回滚场景检查新旧对象及实验数据的处置边界。"
      ],
      "outcome": "形成可复用的按日期范围统计登录天数、分层并稳定分桶的服务端能力，完成两期周末登录活动的代码与配置演进，使活动分流从一次性配置提升为具备稳定归组、可验证、可观测和可回滚能力的实验闭环。",
      "handoff": "已形成两期活动代码与配置演进记录；公开层只保留脱敏工程摘要，不公开内部实现与业务指标。",
      "status": "DELIVERED",
      "contributionType": "PRIMARY",
