{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.example/schemas/eval-suite.schema.json",
  "title": "Portfolio Agent evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteId", "datasetVersion", "cases"],
  "properties": {
    "schemaVersion": {"type": "string", "minLength": 1},
    "suiteId": {"type": "string", "minLength": 1},
    "datasetVersion": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/evalCase"}}
  },
  "$defs": {
    "evalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "split", "origin", "riskLevel", "reviewStatus", "reviewerId", "sourceCategory", "difficultyReason", "firstExposedDatasetVersion", "tags", "input", "oracle", "expectations", "execution", "graders", "maintenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "split": {"enum": ["CALIBRATION", "HOLDOUT", "REGRESSION", "CHALLENGE"]},
        "origin": {"enum": ["BUNDLE_GENERATED", "HUMAN_AUTHORED", "INCIDENT_REGRESSION", "SANITIZED_PRODUCTION", "MIGRATED_LEGACY"]},
        "riskLevel": {"enum": ["STANDARD", "HIGH", "INVARIANT"]},
        "reviewStatus": {"type": "string", "minLength": 1},
        "reviewerId": {"type": "string", "minLength": 1},
        "sourceCategory": {"type": "string", "minLength": 1},
        "difficultyReason": {"type": "string", "minLength": 1},
        "firstExposedDatasetVersion": {"type": "string", "minLength": 1},
        "tags": {"$ref": "#/$defs/nonBlankStrings"},
        "input": {"$ref": "#/$defs/input"},
        "oracle": {"$ref": "#/$defs/oracle"},
        "expectations": {"$ref": "#/$defs/expectations"},
        "execution": {"$ref": "#/$defs/execution"},
        "graders": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/grader"}},
        "maintenance": {"$ref": "#/$defs/maintenance"}
      }
    },
    "nonBlankStrings": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}},
    "input": {
      "type": "object", "additionalProperties": false, "required": ["messages"],
      "properties": {"messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}}}
    },
    "message": {
      "type": "object", "additionalProperties": false, "required": ["role", "content"],
      "properties": {"role": {"type": "string", "minLength": 1}, "content": {"type": "string", "minLength": 1}}
    },
    "oracle": {
      "type": "object", "additionalProperties": false, "required": ["expectedSubjects"],
      "properties": {"expectedSubjects": {"type": "array", "items": {"$ref": "#/$defs/subjectRef"}}}
    },
    "subjectRef": {
      "type": "object", "additionalProperties": false, "required": ["type", "slug"],
      "properties": {"type": {"enum": ["OWNER", "PROJECT", "CASE", "INTERNSHIP"]}, "slug": {"type": "string", "minLength": 1}}
    },
    "expectations": {
      "type": "object", "additionalProperties": false,
      "required": ["resolution", "answerScope", "requiredClaimIds", "allowedEvidenceIds", "forbiddenSubjectSlugs", "forbiddenBehaviors"],
      "properties": {
        "resolution": {"type": "array", "items": {"enum": ["ANSWERED", "NEEDS_CLARIFICATION", "NOT_SUPPORTED", "CAPABILITY_UNAVAILABLE", "BOUNDARY", "REJECTED"]}},
        "answerScope": {"type": "array", "items": {"enum": ["CONVERSATION", "GENERAL", "PORTFOLIO", "HYBRID", "GLOBAL", "MIXED"]}},
        "requiredClaimIds": {"$ref": "#/$defs/nonBlankStrings"},
        "allowedEvidenceIds": {"$ref": "#/$defs/nonBlankStrings"},
        "forbiddenSubjectSlugs": {"$ref": "#/$defs/nonBlankStrings"},
        "forbiddenBehaviors": {"$ref": "#/$defs/nonBlankStrings"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false, "required": ["layers", "providerTrials"],
      "properties": {"layers": {"type": "array", "minItems": 1, "items": {"enum": ["BUNDLE_CONTRACT", "SUBJECT_INTERNAL_RETRIEVAL", "FULL_CORPUS_RETRIEVAL", "INTELLIGENCE", "HTTP_E2E", "PROVIDER"]}}, "providerTrials": {"type": "integer", "minimum": 1}}
    },
    "grader": {
      "type": "object", "additionalProperties": false, "required": ["type", "severity"],
      "properties": {"type": {"type": "string", "minLength": 1}, "severity": {"enum": ["BLOCKING", "SCORED"]}}
    },
    "maintenance": {
      "type": "object", "additionalProperties": false, "required": ["subjectRefs", "generatedFromBundle"],
      "properties": {"subjectRefs": {"type": "array", "items": {"$ref": "#/$defs/subjectRef"}}, "generatedFromBundle": {"type": "boolean"}}
    }
  }
}
