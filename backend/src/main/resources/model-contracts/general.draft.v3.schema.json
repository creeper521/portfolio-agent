{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio-agent:model-contract:general.draft.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "statements", "caveats"],
  "properties": {
    "topic": {"type": "string", "minLength": 1, "maxLength": 4000},
    "statements": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/definitionStatement"},
        {"$ref": "#/$defs/mechanismStatement"}
      ],
      "items": false
    },
    "caveats": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/$defs/caveat"}
    }
  },
  "$defs": {
    "definitionStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "text", "subject", "dimension", "aspects"],
      "properties": {
        "role": {"const": "DEFINITION"},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "subject": {"type": "null"},
        "dimension": {"type": "null"},
        "aspects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{"const": "DEFINITION"}],
          "items": false
        }
      }
    },
    "mechanismStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "text", "subject", "dimension", "aspects"],
      "properties": {
        "role": {"const": "MECHANISM"},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "subject": {"type": "null"},
        "dimension": {"type": "null"},
        "aspects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{"const": "MECHANISM"}],
          "items": false
        }
      }
    },
    "caveat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {"enum": ["APPLICABILITY_BOUNDARY", "RISK", "EXCEPTION"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
