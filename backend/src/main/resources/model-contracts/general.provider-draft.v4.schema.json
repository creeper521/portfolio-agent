{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio-agent:model-contract:general.provider-draft.v4",
  "type": "object",
  "additionalProperties": true,
  "required": ["definition", "mechanism"],
  "properties": {
    "definition": {"$ref": "#/$defs/coreText"},
    "mechanism": {"$ref": "#/$defs/coreText"},
    "caveats": {}
  },
  "$defs": {
    "coreText": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 4000},
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      ]
    }
  }
}
