{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio-agent:model-contract:general.draft.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "statements", "caveats"],
  "properties": {
    "topic": {"type": "string", "minLength": 1, "maxLength": 4000},
    "statements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "text", "aspects"],
        "properties": {
          "role": {"enum": ["DEFINITION", "MECHANISM", "COMPARISON"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 4000},
          "subject": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
          "dimension": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
          "aspects": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {"enum": ["DEFINITION", "MECHANISM", "TYPICAL_USAGE", "APPLICABILITY_BOUNDARY", "TRADE_OFF", "COMMON_MISCONCEPTION", "BOUNDARY_CONDITION"]}
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": {"enum": ["APPLICABILITY_BOUNDARY", "RISK", "EXCEPTION"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
