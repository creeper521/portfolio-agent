{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio-agent:model-contract:goal.provider-draft.v2",
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "inputText"],
      "properties": {
        "kind": {"enum": ["PROJECT", "CASE"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 128},
        "inputText": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "subjects": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/subject"}
    },
    "facets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"enum": [
        "OVERVIEW", "BACKGROUND", "RESPONSIBILITY",
        "SOLUTION", "VERIFICATION", "STATUS"
      ]}
    },
    "depth": {
      "enum": ["CONCISE", "STANDARD", "DETAILED"]
    },
    "portfolioDimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"enum": [
        "ARCHITECTURE", "IMPLEMENTATION", "OUTCOME", "RISKS", "VERIFICATION"
      ]}
    },
    "generalDimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Z_]{1,64}$"
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 96}
    },
    "portfolioFactGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalKind", "facets", "depth"],
      "properties": {
        "goalKind": {"const": "PORTFOLIO_FACT"},
        "subjects": {"$ref": "#/$defs/subjects"},
        "facets": {"$ref": "#/$defs/facets"},
        "depth": {"$ref": "#/$defs/depth"}
      }
    },
    "portfolioCompareGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalKind", "subjects", "dimensions"],
      "properties": {
        "goalKind": {"const": "PORTFOLIO_COMPARE"},
        "subjects": {
          "allOf": [
            {"$ref": "#/$defs/subjects"},
            {"minItems": 2}
          ]
        },
        "dimensions": {"$ref": "#/$defs/portfolioDimensions"}
      }
    },
    "portfolioRecommendGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalKind", "requestedSize", "constraints"],
      "properties": {
        "goalKind": {"const": "PORTFOLIO_RECOMMEND"},
        "requestedSize": {"type": "integer", "minimum": 1, "maximum": 5},
        "constraints": {"$ref": "#/$defs/constraints"}
      }
    },
    "generalExplanationGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalKind", "topicText", "depth"],
      "properties": {
        "goalKind": {"const": "GENERAL_EXPLANATION"},
        "topicText": {"type": "string", "minLength": 1, "maxLength": 256},
        "depth": {"$ref": "#/$defs/depth"}
      }
    },
    "generalComparisonGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalKind", "subjectTexts", "dimensions"],
      "properties": {
        "goalKind": {"const": "GENERAL_COMPARISON"},
        "subjectTexts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "dimensions": {"$ref": "#/$defs/generalDimensions"}
      }
    },
    "applyGeneralConceptGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goalKind", "conceptText", "portfolioFacet", "depth"
      ],
      "properties": {
        "goalKind": {"const": "APPLY_GENERAL_CONCEPT_TO_PORTFOLIO"},
        "subjects": {"$ref": "#/$defs/subjects"},
        "conceptText": {"type": "string", "minLength": 1, "maxLength": 256},
        "portfolioFacet": {"enum": [
          "OVERVIEW", "BACKGROUND", "RESPONSIBILITY",
          "SOLUTION", "VERIFICATION", "STATUS"
        ]},
        "depth": {"$ref": "#/$defs/depth"}
      }
    },
    "completeGoal": {
      "oneOf": [
        {"$ref": "#/$defs/portfolioFactGoal"},
        {"$ref": "#/$defs/portfolioCompareGoal"},
        {"$ref": "#/$defs/portfolioRecommendGoal"},
        {"$ref": "#/$defs/generalExplanationGoal"},
        {"$ref": "#/$defs/generalComparisonGoal"},
        {"$ref": "#/$defs/applyGeneralConceptGoal"}
      ]
    },
    "factSubjectClarificationGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalKind", "facets", "depth"],
      "properties": {
        "goalKind": {"const": "PORTFOLIO_FACT"},
        "facets": {"$ref": "#/$defs/facets"},
        "depth": {"$ref": "#/$defs/depth"}
      }
    },
    "compareSubjectClarificationGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalKind", "dimensions"],
      "properties": {
        "goalKind": {"const": "PORTFOLIO_COMPARE"},
        "subjects": {
          "allOf": [
            {"$ref": "#/$defs/subjects"},
            {"minItems": 1, "maxItems": 1}
          ]
        },
        "dimensions": {"$ref": "#/$defs/portfolioDimensions"}
      }
    },
    "recommendSizeClarificationGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalKind", "constraints"],
      "properties": {
        "goalKind": {"const": "PORTFOLIO_RECOMMEND"},
        "constraints": {"$ref": "#/$defs/constraints"}
      }
    },
    "clarification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "prompt", "goal"],
          "properties": {
            "field": {"const": "SUBJECT"},
            "prompt": {"type": "string", "minLength": 1, "maxLength": 400},
            "goal": {"$ref": "#/$defs/factSubjectClarificationGoal"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "prompt", "goal"],
          "properties": {
            "field": {"const": "SUBJECT"},
            "prompt": {"type": "string", "minLength": 1, "maxLength": 400},
            "goal": {"$ref": "#/$defs/compareSubjectClarificationGoal"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "prompt", "goal"],
          "properties": {
            "field": {"const": "REQUESTED_SIZE"},
            "prompt": {"type": "string", "minLength": 1, "maxLength": 400},
            "goal": {"$ref": "#/$defs/recommendSizeClarificationGoal"}
          }
        }
      ]
    },
    "recentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalId"],
      "properties": {
        "goalId": {"type": "string", "minLength": 1, "maxLength": 96},
        "sectionId": {"type": "string", "minLength": 1, "maxLength": 96}
      }
    },
    "nullLiteral": {"type": "null"},
    "stringCarrier": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20000
    },
    "goalCarrier": {
      "anyOf": [
        {"$ref": "#/$defs/completeGoal"},
        {"$ref": "#/$defs/stringCarrier"}
      ]
    },
    "recentReferenceCarrier": {
      "anyOf": [
        {"$ref": "#/$defs/recentReference"},
        {"$ref": "#/$defs/stringCarrier"},
        {"$ref": "#/$defs/nullLiteral"}
      ]
    },
    "clarificationCarrier": {
      "anyOf": [
        {"$ref": "#/$defs/clarification"},
        {"$ref": "#/$defs/stringCarrier"}
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "message"],
      "properties": {
        "decision": {"const": "CONVERSATIONAL"},
        "message": {"type": "string", "minLength": 1, "maxLength": 400},
        "candidateKey": {"$ref": "#/$defs/nullLiteral"},
        "goal": {"$ref": "#/$defs/nullLiteral"},
        "clarification": {"$ref": "#/$defs/nullLiteral"},
        "recentReference": {"$ref": "#/$defs/nullLiteral"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "goal"],
      "properties": {
        "decision": {"const": "STANDARD_GOAL"},
        "goal": {"$ref": "#/$defs/goalCarrier"},
        "recentReference": {"$ref": "#/$defs/recentReferenceCarrier"},
        "message": {"$ref": "#/$defs/nullLiteral"},
        "candidateKey": {"$ref": "#/$defs/nullLiteral"},
        "clarification": {"$ref": "#/$defs/nullLiteral"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "goal"],
      "properties": {
        "decision": {"const": "CONTINUE_CURRENT_PROJECT"},
        "goal": {"$ref": "#/$defs/goalCarrier"},
        "message": {"$ref": "#/$defs/nullLiteral"},
        "candidateKey": {"$ref": "#/$defs/nullLiteral"},
        "clarification": {"$ref": "#/$defs/nullLiteral"},
        "recentReference": {"$ref": "#/$defs/nullLiteral"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "candidateKey"],
      "properties": {
        "decision": {"const": "ENTER_RECOMMENDED_RESULT"},
        "candidateKey": {"type": "string", "pattern": "^C[1-5]$"},
        "message": {"$ref": "#/$defs/nullLiteral"},
        "goal": {"$ref": "#/$defs/nullLiteral"},
        "clarification": {"$ref": "#/$defs/nullLiteral"},
        "recentReference": {"$ref": "#/$defs/nullLiteral"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "candidateKey"],
      "properties": {
        "decision": {"const": "SWITCH_PROJECT"},
        "candidateKey": {"type": "string", "pattern": "^C[1-5]$"},
        "message": {"$ref": "#/$defs/nullLiteral"},
        "goal": {"$ref": "#/$defs/nullLiteral"},
        "clarification": {"$ref": "#/$defs/nullLiteral"},
        "recentReference": {"$ref": "#/$defs/nullLiteral"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": {"const": "START_NEW_TOPIC"},
        "message": {"$ref": "#/$defs/nullLiteral"},
        "candidateKey": {"$ref": "#/$defs/nullLiteral"},
        "goal": {"$ref": "#/$defs/nullLiteral"},
        "clarification": {"$ref": "#/$defs/nullLiteral"},
        "recentReference": {"$ref": "#/$defs/nullLiteral"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": {"const": "REENTER_PROJECT"},
        "message": {"$ref": "#/$defs/nullLiteral"},
        "candidateKey": {"$ref": "#/$defs/nullLiteral"},
        "goal": {"$ref": "#/$defs/nullLiteral"},
        "clarification": {"$ref": "#/$defs/nullLiteral"},
        "recentReference": {"$ref": "#/$defs/nullLiteral"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": {"const": "NEEDS_CLARIFICATION"},
        "message": {"$ref": "#/$defs/nullLiteral"},
        "candidateKey": {"$ref": "#/$defs/nullLiteral"},
        "goal": {"$ref": "#/$defs/nullLiteral"},
        "clarification": {"$ref": "#/$defs/nullLiteral"},
        "recentReference": {"$ref": "#/$defs/nullLiteral"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "clarification"],
      "properties": {
        "decision": {"const": "NEEDS_CLARIFICATION"},
        "clarification": {"$ref": "#/$defs/clarificationCarrier"},
        "message": {"$ref": "#/$defs/nullLiteral"},
        "candidateKey": {"$ref": "#/$defs/nullLiteral"},
        "goal": {"$ref": "#/$defs/nullLiteral"},
        "recentReference": {"$ref": "#/$defs/nullLiteral"}
      }
    }
  ]
}
