<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="LOCAL_LOG_DIRECTORY"
                    source="portfolio.log-directory" defaultValue=""/>

    <springProfile name="local-file-logging">
        <appender name="BACKEND_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOCAL_LOG_DIRECTORY}/current/backend-info.log</file>
            <filter class="com.portfolio.agent.common.observability.BrowserOriginEventFilter"/>
            <filter class="ch.qos.logback.classic.filter.LevelFilter">
                <level>ERROR</level>
                <onMatch>DENY</onMatch>
                <onMismatch>NEUTRAL</onMismatch>
            </filter>
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>DEBUG</level>
            </filter>
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level %logger{48} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOCAL_LOG_DIRECTORY}/archive/backend-info.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>20MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <appender name="BACKEND_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOCAL_LOG_DIRECTORY}/current/backend-error.log</file>
            <filter class="com.portfolio.agent.common.observability.BrowserOriginEventFilter"/>
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>ERROR</level>
            </filter>
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level %logger{48} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOCAL_LOG_DIRECTORY}/archive/backend-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>20MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="BACKEND_INFO"/>
            <appender-ref ref="BACKEND_ERROR"/>
        </root>
        <logger name="com.portfolio.agent" level="DEBUG"/>
    </springProfile>

    <springProfile name="!local-file-logging">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
